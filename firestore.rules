rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isDrawType(value) {
      return value in ['coffee', 'clean'];
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.createdAt is timestamp;
      allow delete: if true;
      allow update: if false;
    }

    match /rounds/{roundId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['type', 'roundNumber', 'createdAt'])
        && isDrawType(request.resource.data.type)
        && request.resource.data.roundNumber is int
        && request.resource.data.roundNumber > 0
        && request.resource.data.createdAt is timestamp;
      allow delete: if false;
      allow update: if false;
    }

    match /draws/{drawId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'employeeId',
          'employeeName',
          'type',
          'roundNumber',
          'accepted',
          'date'
        ])
        && isNonEmptyString(request.resource.data.employeeId)
        && isNonEmptyString(request.resource.data.employeeName)
        && isDrawType(request.resource.data.type)
        && request.resource.data.roundNumber is int
        && request.resource.data.roundNumber > 0
        && request.resource.data.accepted == true
        && request.resource.data.date is timestamp;
      allow delete: if false;
      allow update: if false;
    }
  }
}
